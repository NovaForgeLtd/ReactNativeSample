FROM node:22-alpine

WORKDIR /app

ENV CI=1 \
    EXPO_NO_TELEMETRY=1 \
    BROWSER=none

COPY package.json package-lock.json ./
RUN npm ci

COPY . .

# Expo web packages are intentionally installed in the web image so the native
# package manifest remains focused on the iOS/Android build while this container
# can run the same React Native application in a browser.
RUN npx expo install react-dom react-native-web @expo/metro-runtime

EXPOSE 8081

CMD ["npm", "run", "web", "--", "--host", "lan", "--port", "8081"]
